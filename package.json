{
  "name": "oncomente-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "lerna": "^9.0.7",
    "typescript": "^5.0.0"
  },
  "scripts": {
    "start:backend": "lerna run start:dev --scope backend",
    "start:mobile": "lerna run start --scope mobile",
    "start:web": "lerna run dev --scope web",
    "build": "lerna run build",
    "test": "lerna run test"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "@nestjs/swagger": "^11.4.4"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "bcrypt@6.0.0": true,
    "esbuild@0.27.7": true,
    "nx@22.7.1": true,
    "prisma@6.19.3": true,
    "unrs-resolver@1.11.1": true,
    "@nestjs/core": false,
    "@scarf/scarf": false
  }
}
