# Ambiente dos testes e2e. Valores fictícios: nada aqui é segredo real.
# O banco precisa ter "_test" no nome; o global-setup recusa qualquer outro.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/oncomente_test"
NODE_ENV="test"
JWT_SECRET="e2e-jwt-secret-with-more-than-32-characters"
PSEUDONYM_KEY="e2e-pseudonym-key-with-more-than-32-characters"
JWT_ACCESS_TTL="15m"
REFRESH_TTL_DAYS="7"
CONSENT_TERM_VERSION="1.0"
GROQ_API_KEY="e2e-fake-key"
SMTP_HOST="localhost"
SMTP_PORT="2525"
SMTP_USER="e2e"
SMTP_PASS="e2e"
