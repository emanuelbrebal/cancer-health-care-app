DATABASE_URL="postgresql://postgres:postgres@localhost:5432/oncomente"
# Em produção o servidor recusa subir com este valor de exemplo ou com menos de 32 caracteres.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="change-this-to-a-strong-random-secret"
NODE_ENV="development"
PORT="3000"
# Origens liberadas no CORS, separadas por vírgula (Expo Web e painel admin).
# Em produção, vazio = nenhuma origem web liberada (o app nativo não depende de CORS).
CORS_ORIGINS=""

# Sessão: access token curto + refresh token rotativo com janela deslizante.
JWT_ACCESS_TTL="15m"
REFRESH_TTL_DAYS="7"

# Versão do termo de consentimento. Ao mudar, os aceites anteriores deixam de valer
# e o app pede o consentimento de novo.
CONSENT_TERM_VERSION="1.0"

# Chave do HMAC que pseudonimiza o id do usuário em auditoria, conversas do mascote e
# registro de exclusão. Se trocar, os registros antigos deixam de casar com os novos.
# Obrigatória em produção: 32+ caracteres e diferente do JWT_SECRET (o servidor recusa subir).
PSEUDONYM_KEY=""

# Mascote (Groq — OpenAI-compatible API). Obtenha em https://console.groq.com/keys
GROQ_API_KEY=""

# SMTP — configurar com seu provedor de email (Gmail, SendGrid, Mailgun, etc.)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="seu-email@gmail.com"
SMTP_PASS="sua-senha-de-app"
SMTP_FROM="OncoMente <seu-email@gmail.com>"
