generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==============================
// ENUMS GLOBAIS
// ==============================
enum StatusEnum {
  ACTIVE
  INACTIVE
  DELETED
  PENDING
  ARCHIVED
}

// ==============================
// MODELOS: USUÁRIO E MENSAGEM DIÁRIA
// ==============================

enum UserRole {
  PATIENT
  CAREGIVER
  ADMIN
}

enum PronounEnum {
  SR
  SRA
  SRTA
  CUSTOM
  NOT_INFORMED
}

model User {
  id       String   @id @default(uuid())
  email    String   @unique @db.VarChar(200)
  password String
  role     UserRole @default(PATIENT)

  createdAt DateTime @default(now())

  name            String?      @db.VarChar(50)
  pronoun         PronounEnum? @default(NOT_INFORMED)
  phone_number    String?      @db.VarChar(20)
  birthday        DateTime?
  profile_picture String?

  lastAiAnalysis DateTime?

  // INACTIVE = acesso suspenso pelo titular ou por ADMIN; os dados ficam preservados.
  status      StatusEnum @default(ACTIVE)
  suspendedAt DateTime?

  logs          DailyLog[]
  treatments    Treatment[]
  refreshTokens RefreshToken[]
  consents      ConsentRecord[]

}

// Sessão persistente: só o hash do refresh token é guardado. A cada uso o token é
// trocado por outro da mesma família; reuso de um token já trocado revoga a família.
model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  familyId  String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

enum ConsentPurpose {
  HEALTH_DATA
  AI_MASCOT
  NOTIFICATIONS
}

// Consentimento LGPD por finalidade. Só inserção: cada mudança é uma linha nova e o
// estado atual é a mais recente por finalidade. Sem linha = negado.
model ConsentRecord {
  id          String         @id @default(uuid())
  purpose     ConsentPurpose
  granted     Boolean
  termVersion String         @db.VarChar(20)
  createdAt   DateTime       @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt])
  @@map("consent_records")
}

// Registro de exclusão de conta sem dado pessoal: userRef é o id pseudonimizado.
model UserDeletionLog {
  id        String   @id @default(uuid())
  userRef   String   @map("userId")
  role      String
  reason    String?
  deletedAt DateTime @default(now())

  @@map("user_deletion_logs")
}

model DailyMessage {
  id      String     @id @default(uuid())
  title   String?    @db.VarChar(25)
  message String?    @db.VarChar(25)
  status  StatusEnum @default(ACTIVE)
}

// ==============================
// MODELS: ONCOLOGY AND MEDIA TYPES
// ==============================

enum GenreType {
  BOOK
  MOVIE
  SERIES
}

model Genre {
  id     String     @id @default(uuid())
  name   String
  type   MediaType
  status StatusEnum @default(ACTIVE)
  medias Media[]

  // O mesmo nome pode existir em tipos diferentes (ex.: "Drama" para filme e série).
  @@unique([name, type])
}

enum MediaType {
  BOOK
  MOVIE
  SERIES
}

model Media {
  id          String     @id @default(uuid())
  title       String     @db.VarChar(150)
  releaseYear Int?
  type        MediaType
  status      StatusEnum @default(ACTIVE)
  isFree      Boolean    @default(false)
  whereToFind String[]   @default([])
  image_path  String
  synopsis    String?    @db.Text
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  genreId String
  genre   Genre  @relation(fields: [genreId], references: [id])

  bookDetails   BookDetail?
  movieDetails  MovieDetail?
  seriesDetails SeriesDetail?

  // Unicidade por tipo fica no serviço (assertUniqueMedia): livro = título + autor (autor está em
  // BookDetail), filme/série = título + ano. Índice entre tabelas não existe no Postgres.
  @@index([type, status])
}

enum LeisureType {
  PHYSICAL
  CULTURAL
  SOCIAL
  THERAPY
  RECREATIONAL
  REST
}

enum FrequencyType {
  DAILY
  WEEKLY
  FORTWEEKLY
  MONTHLY
  SPORADICAL
}

model LeisureActivity {
  id         String        @id @default(uuid())
  name       String        @db.VarChar(150)
  type       LeisureType
  frequency  FrequencyType
  image_path String
  synopsis   String?       @db.Text
  status     StatusEnum    @default(ACTIVE)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@unique([name])
}

model SeriesDetail {
  id           String  @id @default(uuid())
  showrunner   String? @db.VarChar(120)
  seasons      Int?
  episodes     Int?
  externalLink String?

  mediaId String @unique
  media   Media  @relation(fields: [mediaId], references: [id])
}

model MovieDetail {
  id           String  @id @default(uuid())
  director     String? @db.VarChar(120)
  duration     String? @db.VarChar(120)
  externalLink String?

  mediaId String @unique
  media   Media  @relation(fields: [mediaId], references: [id])
}

model BookDetail {
  id           String  @id @default(uuid())
  author       String  @db.VarChar(120)
  eduCapesLink String?
  page_count   Int?
  visitCount   Int     @default(0)

  mediaId String @unique
  media   Media  @relation(fields: [mediaId], references: [id])
}

// ==============================
// MODELS: PERSONAL AREA
// ==============================
model DailyLog {
  id        String   @id @default(uuid())
  title     String   @db.VarChar(150)
  content   String   @db.VarChar(2000)
  
  emotes    String[] 
  
  date      DateTime @default(now()) @db.Date 

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model DailyLogAudit {
  id        String   @id @default(uuid())
  logId     String
  userId    String
  action    String   
  timestamp DateTime @default(now())
}

// ==============================
// MODELS: MASCOT USECASE
// ==============================
model PatientSupportLog {
  id        String   @id @default(uuid())
  userId    String
  prompt    String
  response  String
  context   Json
  createdAt DateTime @default(now())
}

// ==============================
// MODELS: TREATMENTS
// ==============================
model Treatment {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  frequency     String
  startTime     String
  endDate       DateTime
  doctorName    String?
  doctorContact String?
  hospitalName  String?
  status        String    @default("ACTIVE")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("treatments")
}